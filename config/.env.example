# Environment Configuration
# Copy this to .env and fill in your values

# ============================================
# Google Cloud Platform
# ============================================
GOOGLE_PROJECT_ID=ultimate-vigil-471521-r4
GOOGLE_APPLICATION_CREDENTIALS=/workspace/gcp-key.json
GCS_BUCKET=gs://ai-models-storage

# ============================================
# AWS (Optional)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=s3://ai-models-backup

# ============================================
# GitHub
# ============================================
GITHUB_TOKEN=
GITHUB_REPO=haniyehkeshmiri27-arch/ai-ultimate-platform

# ============================================
# API Keys
# ============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ============================================
# Hugging Face
# ============================================
HUGGINGFACE_TOKEN=

# ============================================
# Database
# ============================================
DATABASE_URL=sqlite:///./platform.db
REDIS_URL=redis://localhost:6379

# ============================================
# Security
# ============================================
SECRET_KEY=change-this-to-random-string
JWT_SECRET=change-this-to-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Application
# ============================================
APP_NAME=AI Ultimate Platform
APP_VERSION=1.0.0
DEBUG=false

# ============================================
# Paths
# ============================================
MODELS_DIR=/workspace/ComfyUI/models
TRAINING_DIR=/workspace/training
WORKFLOWS_DIR=/workspace/workflows
BACKUP_DIR=/workspace/backups

# ============================================
# Services
# ============================================
COMFYUI_URL=http://localhost:8188
KOHYA_URL=http://localhost:7860
API_URL=http://localhost:5000

# ============================================
# Training Defaults
# ============================================
DEFAULT_STEPS=2500
DEFAULT_LEARNING_RATE=0.0001
DEFAULT_BATCH_SIZE=1
DEFAULT_RESOLUTION=1024

# ============================================
# Domain & SSL
# ============================================
DOMAIN=
SSL_EMAIL=

# ============================================
# Monitoring
# ============================================
SENTRY_DSN=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
