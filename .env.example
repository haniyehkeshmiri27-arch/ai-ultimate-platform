# ============================================
# Environment Variables - SECURE CONFIGURATION
# ============================================
# Copy this file to .env and fill with your actual values
# NEVER commit .env to git!

# ============================================
# Hugging Face
# ============================================
HUGGINGFACE_TOKEN=your_hf_token_here

# ============================================
# CivitAI
# ============================================
CIVITAI_API_KEY=your_civitai_key_here

# ============================================
# Google Cloud Platform
# ============================================
GOOGLE_CLOUD_PROJECT=ultimate-vigil-471521-r4
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
VERTEX_AI_SERVICE_ACCOUNT=vertex-express@ultimate-vigil-471521-r4.iam.gserviceaccount.com

# Google Cloud Storage HMAC Keys
GCS_ACCESS_KEY_ID=your_gcs_access_key
GCS_SECRET_ACCESS_KEY=your_gcs_secret_key

# ============================================
# Google AI Studio (Gemini)
# ============================================
GOOGLE_API_KEY=your_gemini_api_key

# ============================================
# OpenAI
# ============================================
OPENAI_API_KEY=your_openai_key_here

# ============================================
# GitHub
# ============================================
GITHUB_TOKEN=your_github_token
GITHUB_PAT_ALL=your_github_pat_all
GITHUB_PAT_HF=your_github_pat_hf

# ============================================
# AWS (sertila user)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_ACCOUNT_ID=389745330336
AWS_CONSOLE_URL=https://389745330336.signin.aws.amazon.com/console
AWS_USERNAME=sertila
AWS_REGION=us-east-1

# ============================================
# Application Settings
# ============================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info
